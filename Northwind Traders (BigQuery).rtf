\cf0 ## Determine the 2nd most expensive product being sold\
SELECT \
pd.productName as product,\
MAX(pd.unitPrice) as second_exp\
\
FROM `Northwind_Traders.products` pd\
\
GROUP BY 1\
ORDER BY 2 DESC\
LIMIT 1 OFFSET 1\
\
## Total number of Freights per month\
\
SELECT\
date_trunc(ord.orderDate, MONTH) as M,\
ROUND(SUM(ord.freight),1) as Total_Freight\
\
\
\
FROM `Northwind_Traders.orders` as ord\
\
LEFT JOIN `Northwind_Traders.shippers` as sp\
ON ord.shipperID = sp.shipperID\
\
GROUP BY  1\
\
\
\
##Total number of monthly order of each Shipping Line\
\
SELECT\
date_trunc(ord.orderDate, MONTH) as M,\
COUNTIF(ord.shipperID = 1) as Speedy,\
COUNTIF(ord.shipperID = 2) as United_Package,\
COUNTIF(ord.shipperID = 3) as Federal\
\
\
FROM `Northwind_Traders.orders` as ord\
\
LEFT JOIN `Northwind_Traders.shippers` as sp\
ON ord.shipperID = sp.shipperID\
\
GROUP BY  1\
\
## Average Shipment Days on each country\
\
SELECT\
cs.country as Country,\
ROUND(AVG(DATE_DIFF(shippedDate, orderDate, DAY)),1) as Days_Shipped\
\
\
\
FROM `Northwind_Traders.orders` as ord\
\
LEFT JOIN `Northwind_Traders.Customer` as cs\
ON ord.customerID = cs.customer_id\
\
GROUP BY  1\
\
